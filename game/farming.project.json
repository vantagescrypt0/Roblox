{
  "name": "RobloxSimFarming",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Blocks": {
        "$path": "assets-replicated/Blocks.rbxm"
      },
      "ItemModels": {
        "$path": "assets-replicated/ItemModels.rbxm"
      },
      "ShieldModels": {
        "$path": "assets-replicated/ShieldModels.rbxm"
      },
      "DecorModels": {
        "$path": "assets-replicated/DecorModels.rbxm"
      }
    },

    "ServerStorage": {
      "Assets": {
        "$path": "assets"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "TextChatService": {
      "$properties": {
        "ChatVersion": "TextChatService"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": true,
        "StreamingMinRadius": 64,
        "StreamingTargetRadius": 1024,
        "StreamOutBehavior": "Opportunistic",
        "StreamingIntegrityMode": "PauseOutsideLoadedArea"
      },
      "$attributes": {
        "PlaceKind": "Farming"
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Future"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}